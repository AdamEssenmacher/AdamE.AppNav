<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<PackageId>AdamE.AppNav.Android</PackageId>
		<Description>Android presenter for AdamE.AppNav: one activity's frame, a pushed page and route-owned dialogs, with route-entry leases and activity recreation.</Description>
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
		<AndroidResourceDesignerClassModifier>internal</AndroidResourceDesignerClassModifier>
		<PackageTags>android;androidx;navigation;application-navigation;router;deep-linking</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
		<!-- ComponentActivity, ComponentDialog and their back dispatchers. -->
		<PackageReference Include="Xamarin.AndroidX.Activity" Version="1.13.0.1" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI.Unshipped.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AdamE.AppNav\AdamE.AppNav.csproj" />
	</ItemGroup>

</Project>
